# DashScope API Key
# 从 https://dashscope.console.aliyun.com/ 获取
DASHSCOPE_API_KEY=Your_API_key

# Tavily API Key (用于网络搜索)
# 从 https://tavily.com/ 获取
TAVILY_API_KEY=Your_API_key

# OpenRouter API Key和模型配置
# 从 https://openrouter.ai/ 获取
OPENROUTER_API_KEY=Your_API_key

MODEL_ID = openai/gpt-4o-mini
MODEL_BASE_URL = https://openrouter.ai/api/v1

# Server Configuration
# 服务监听地址和端口。如果 8000 端口被其他项目占用，可修改此端口（例如 8001）
SERVER_HOST = 0.0.0.0
SERVER_PORT = 8000

# 前端访问后端的 API 及 WebSocket 地址（可选，仅当独立/跨域部署前端时配置）
# 默认留空，前端会自动使用与网页相同的域名和端口
# API_BASE_URL = http://127.0.0.1:8000
# WS_BASE_URL = ws://127.0.0.1:8000